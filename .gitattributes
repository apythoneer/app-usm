# Normalize line endings — store as LF, checkout as-is on all platforms
* text=auto eol=lf

# Force LF for these types (scripts break with CRLF)
*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# Binary — no line ending conversion
*.png binary
*.jpg binary
*.ico binary
*.gz binary
