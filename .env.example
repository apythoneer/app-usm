# ============================================================
# USM v3 — Environment Configuration Template
# Copy to .env and fill in real values before deploying.
# All variables are read by backend/app/core/config.py (Pydantic Settings).
# ============================================================

# ---- App ----
APP_NAME=Unified Storage Monitoring
APP_VERSION=3.1.0
DEBUG=false
LOG_DIR=/app/logs

# ---- Process role & runtime ----
# The scheduler + collectors run in a SEPARATE container from the API:
#   API container       -> RUN_SCHEDULER=false, API_WORKERS>1 (safe to scale)
#   Collector container -> RUN_SCHEDULER=true  (run exactly ONE; owns migrations)
RUN_SCHEDULER=true
API_WORKERS=4
# Per-request DB statement timeout (seconds): API 30 / collector 120.
DB_QUERY_TIMEOUT=30
# pyodbc pre-ping before handing out a pooled connection.
DB_PREPING=true

# ---- API / CORS ----
API_V1_PREFIX=/api/v1
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:8080","http://usodclpsandadm1.corp.intranet:8080"]

# ---- Security / JWT (Phase 3 — wired but not enforced yet) ----
SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION_USE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- SQL Server ----
SQL_SERVER=usidcvsql0252.ctl.intranet
SQL_DATABASE=StorMart
DB_SCHEMA=USM
SQL_DRIVER=ODBC Driver 17 for SQL Server

# ---- KeePass credential store ----
KEEPASS_URL=http://usodclpsandadm1.corp.intranet:2000/keepass
KEEPASS_PASSWORD=CHANGE_ME
SQL_CRED_KEY=SQLServerDB
PURE_CRED_KEY=PureStorage

# ---- Collector intervals (seconds) ----
METRICS_INTERVAL=300
VOLUMES_INTERVAL=1800
ALERTS_INTERVAL=600

# ---- Alert lifecycle ----
ALERT_RESOLVE_DAYS=7
ALERT_PURGE_DAYS=30

# ---- Metrics history retention (days) ----
# How long per-array metrics_history rows are kept. Extended to 365 to power
# YTD capacity-growth analytics (/analytics/array-growth). Lower to reclaim DB space.
HISTORY_RETENTION_DAYS=365

# ---- Capacity alerting (thresholds + fleet growth projection) ----
# Master on/off switch for the capacity_alerts scheduler job.
CAPACITY_ALERTS_ENABLED=true
# Comma-separated utilization % thresholds. Only the highest exceeded
# threshold per array stays open (auto-resolves when util drops back below).
# >= 90 is sent as "critical", below that as "warning".
CAPACITY_ALERT_THRESHOLDS=80,90,95
# Minimum days between re-sending the same open threshold/projection alert to Teams.
CAPACITY_ALERT_RESEND_DAYS=7
# Fire the fleet-wide alert when growth projection shows "full" within this many days.
CAPACITY_PROJECTED_FULL_DAYS=30
# Trailing window (days of daily_stats) used to compute the fleet growth trend/slope.
CAPACITY_ALERT_TREND_DAYS=90
# How often (hours) the scheduler runs the capacity alert check.
CAPACITY_ALERT_CHECK_INTERVAL_HOURS=12



# ---- Notifications: Microsoft Teams ----
# Webhook URL for the Teams channel. Leave empty to disable Teams alerts.
# Supports BOTH webhook types (payloads use Adaptive Cards):
#   - Legacy Incoming Webhook connector:  https://<tenant>.webhook.office.com/webhookb2/...
#   - Power Automate / Workflows webhook:  https://prod-XX.<region>.logic.azure.com/...
TEAMS_WEBHOOK_URL=
# Comma-separated severities that trigger a Teams alert (critical,warning,info)
TEAMS_SEVERITIES=critical,warning

# ---- Notifications: Datadog (Event Management v2) — the page-alert path ----
# Runtime on/off (also toggleable live via /settings). API key is resolved from
# KeePass (entry named by DATADOG_CRED_KEY); DATADOG_API_KEY is an optional override.
DATADOG_ENABLED=false
DATADOG_CRED_KEY=Datadog
DATADOG_API_KEY=
DATADOG_SEVERITIES=critical,warning
# Restrict Datadog paging to these group_label prefixes (empty=all). Teams unaffected.
DATADOG_NOTIFY_GROUPS=
# Additionally restrict to these vendors (empty=all). groups + vendors is an AND.
DATADOG_NOTIFY_VENDORS=


# ---- Notifications: ServiceNow ----
SNOW_ENABLED=false
# ServiceNow instance (e.g. https://yourcompany.service-now.com)
SNOW_INSTANCE=
SNOW_USER=
SNOW_PASSWORD=
# Comma-separated severities that auto-create incidents
SNOW_SEVERITIES=critical
SNOW_ASSIGNMENT_GROUP=Storage Operations
SNOW_CATEGORY=Infrastructure
SNOW_CI=Storage
# Sync interval (seconds) for creating tickets + checking resolution
SNOW_SYNC_SECONDS=300

# ---- External partner API (/api/ext/v1, read-only) ----
# JSON list of {name, key_sha256, scopes}; empty ⇒ surface disabled (503).
# Mint entries with backend/scripts/gen_external_key.py — only hashes are stored.
EXTERNAL_API_KEYS=[]
EXTERNAL_API_RATE_LIMIT=120

# ---- Chat / Ollama (local LLM) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
CHAT_ENABLED=true
CHAT_QUERY_TIMEOUT=10

# ---- Paths ----
ARRAYS_CONFIG_FILE=/app/config/arrays.txt
USM_CACHE_DB=/app/data/usm_cache.db

# ---- MCP servers (usm-ops) ----
# Base URL the usm-ops MCP server uses to reach the running USM backend
USM_API_BASE=http://usodclpsandadm1.corp.intranet:8000
