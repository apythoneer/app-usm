# USM v2 — Root .env (used by docker-compose.v2.yml)
# Copy to .env and fill in secrets before first run.
# Non-sensitive config is already inlined in docker-compose.v2.yml.

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION

# Teams webhook (optional — leave blank to disable notifications)
TEAMS_WEBHOOK_URL=

# ServiceNow group (optional)
SNOW_GROUP=
