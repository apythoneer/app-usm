# Copy to .env and fill in values

# App
DEBUG=false
LOG_DIR=/app/logs

# API
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Security (generate a real key before production!)
SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION_USE

# SQL Server
SQL_SERVER=usidcvsql0252.ctl.intranet
SQL_DATABASE=StorMart
DB_SCHEMA=USM
SQL_DRIVER=ODBC Driver 17 for SQL Server

# KeePass
KEEPASS_URL=http://usodclpsandadm1.corp.intranet:2000/keepass
SQL_CRED_KEY=SQLServerDB
PURE_CRED_KEY=PureStorage

# Notifications
TEAMS_WEBHOOK_URL=
SNOW_ENABLED=false
SNOW_SEVERITIES=critical
SNOW_CATEGORY=Alert > Infrastructure
SNOW_CI=Pure Storage CBS
SNOW_LOCATION=Denver
SNOW_GROUP=

# Collector intervals (seconds)
METRICS_INTERVAL=60
VOLUMES_INTERVAL=900
ALERTS_INTERVAL=300

# Arrays config
ARRAYS_CONFIG_FILE=/app/config/arrays.txt
