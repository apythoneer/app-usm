# Authenticated front door for the sandbox Ollama (no auth of its own).
# Rendered by entrypoint.sh: __TOKEN__, __LISTEN_PORT__ and __UPSTREAM__ are replaced at start.
worker_processes 2;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 256; }

http {
    access_log /dev/stdout;          # default format: no Authorization header is logged
    server_tokens off;
    client_max_body_size 2m;         # prompts only; nothing big goes in
    map_hash_bucket_size 256;        # the "Bearer <token>" key is longer than the 64-byte default

    map $http_authorization $ollama_authorized {
        default              0;
        "Bearer __TOKEN__"   1;
    }

    upstream ollama { server __UPSTREAM__; keepalive 8; }

    server {
        listen __LISTEN_PORT__;

        location = /healthz { access_log off; return 200 "ok\n"; }

        # Inference + read-only discovery only. /api/pull, /api/delete, /api/push,
        # /api/create, /api/copy and everything else are refused below.
        location ~ ^/api/(chat|generate|embed|embeddings|tags|show|version)$ {
            if ($ollama_authorized = 0) { return 401; }
            proxy_pass http://ollama;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Authorization "";   # never forwarded to Ollama
            proxy_set_header Host "127.0.0.1";   # Ollama 403s any Host it doesn't recognise
            proxy_set_header Origin "";
            proxy_buffering off;                 # streamed responses
            proxy_read_timeout 300s;             # CPU inference is slow
            proxy_send_timeout 300s;
        }

        location / { return 403; }
    }
}
